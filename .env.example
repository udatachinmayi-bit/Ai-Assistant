# Chinu AI — Environment Variable Template
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ---- App ----
CHINU_ENV=development          # development | production
CHINU_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ---- AI Brain / LLM backend ----
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic         # anthropic | local
LLM_MODEL=claude-sonnet-5

# ---- Voice ----
WAKE_WORD=hey_chinu
STT_ENGINE=faster_whisper      # faster_whisper | vosk
TTS_ENGINE=edge_tts            # edge_tts | pyttsx3 | coqui

# ---- Database ----
DATABASE_URL=sqlite:///data/chinu.db

# ---- Dashboard ----
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# ---- Automation safety ----
AUTOMATION_CONFIRMATION_REQUIRED=true
